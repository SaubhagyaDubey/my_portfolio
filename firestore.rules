rules_version = '2';

// Deep Field keeps its leaderboard behind the /api functions, which use the Admin SDK and bypass these
// rules. No browser ever talks to Firestore directly, so every client read and write is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
